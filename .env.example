# ThreadRadar server configuration. Copy to .env and fill in what you use.
# Names only here; never commit real values. Everything stays server-side.

# ---- Server ------------------------------------------------------------------
HOST=127.0.0.1                 # bind address. Anything other than localhost requires APP_PASSWORD.
PORT=3100
APP_ORIGIN=http://127.0.0.1:3100   # public origin (https://... when deployed); used for cookies, CSRF and OAuth redirects
APP_PASSWORD=                  # >= 16 characters. Required for the Live workspace and for any live connector.
DATABASE_PATH=data/threadradar.sqlite
CRITICAL_POLL_SECONDS=60       # how often live sources are polled while critical monitoring is on (min 15)

# ---- AI analysis (optional: without a key the rules analyser runs and is labelled as such) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# or, instead of OpenAI:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# ---- Slack intake (polling mode; bot must be invited to each channel) --------
# Bot token scopes: channels:history, channels:read, users:read (+ groups:history/groups:read for private channels)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=             # comma separated, e.g. C0123ABCD,C0456EFGH
SLACK_BACKFILL_MINUTES=1440    # how far back the first poll looks
# Optional Events API webhook mode instead of polling (needs a public HTTPS APP_ORIGIN):
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=

# ---- Telegram intake + private alerts ---------------------------------------
# Create a bot with @BotFather, disable privacy mode (/setprivacy -> Disable), add it to the watched groups.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=             # comma separated group/supergroup ids, e.g. -1001234567890
TELEGRAM_ALERT_CHAT_ID=        # YOUR private chat id (numeric). Send /start to the bot from your account to verify it.
ALLOW_LIVE_SEND=false          # set to true to allow real Telegram alerts to leave the server
TELEGRAM_MODE=polling          # polling (default, works locally) or webhook (needs HTTPS APP_ORIGIN + secret below)
TELEGRAM_WEBHOOK_SECRET=

# ---- Gmail intake (read-only OAuth) -----------------------------------------
# Google Cloud console: OAuth client (Web application), redirect URI = APP_ORIGIN + /oauth/gmail/callback, scope gmail.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=          # 64 hex chars for encrypting the refresh token at rest: npm run keygen
GMAIL_LABEL_ID=INBOX           # label to watch (INBOX, or a custom label id)
GMAIL_BACKFILL_LIMIT=25        # messages imported on first connect
