# ThreadRadar server configuration. Copy to .env and fill in what you use.
# Names only here; never commit real values. Everything stays server-side.
# Per-user things (Slack/Telegram bot tokens, Gmail authorisation, backfill windows)
# are NOT set here: each user adds them on the Integrations tab. They are stored
# encrypted in the database.

# ---- Server ------------------------------------------------------------------
HOST=127.0.0.1                 # bind address (0.0.0.0 inside Docker)
PORT=3100
APP_ORIGIN=http://127.0.0.1:3100   # public origin (https://... when deployed); used for cookies, CSRF and the Gmail OAuth redirect
DATABASE_PATH=data/threadradar.sqlite
CRITICAL_POLL_SECONDS=60       # how often each user's live sources are polled while critical monitoring is on (min 15)
TOKEN_ENCRYPTION_KEY=          # 64 hex chars (npm run keygen). If empty, a key is generated once into data/secret.key.
ALLOW_LIVE_SEND=false          # set to true to allow real Telegram alerts to leave the server

# ---- AI analysis (optional: without a key the rules analyser runs and is labelled as such) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini      # newest small model at time of writing; gpt-5.4-nano is cheaper, gpt-4.1-mini still works
OPENAI_REASONING_EFFORT=low    # gpt-5 family only: none | low | medium | high
# or, instead of OpenAI:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4-mini

# ---- Gmail OAuth app (server-level; users authorise their own mailbox in the UI) ----
# Google Cloud console: OAuth client (Web application), redirect URI = APP_ORIGIN + /oauth/gmail/callback, scope gmail.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
